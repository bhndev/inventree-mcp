# inventree-mcp configuration.
#
# Copy to a real env file and fill in. Anything ending in .env is gitignored,
# so `cp .env.example mcp.env` will not be committed by accident.
#
# On a server, keep the real file at chmod 600 — it holds credentials that can
# read and modify inventory.
#
# Three deployment shapes are shown below. Uncomment ONE section.


# ── Required in every mode ────────────────────────────────────────────────────

# Base URL of the InvenTree instance. No trailing slash needed.
INVENTREE_URL=https://inventree.example.com


# ── A. Local stdio (default) ──────────────────────────────────────────────────
# Launched by Claude Desktop / Claude Code on your own machine. No network
# listener. Every call is attributed to this token's user.
#
# Get a token: curl -u USER:PASS https://inventree.example.com/api/user/token/

INVENTREE_TOKEN=inv-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-xxxxxxxx


# ── B. Hosted over HTTP, one shared credential ────────────────────────────────
# Simplest hosted option. Everyone in the org shares one secret and InvenTree
# sees a single service account, so it cannot tell users apart.
#
# In Claude: Add custom connector -> Request headers -> Authorization
#            Enter the value including the scheme: "Bearer <MCP_AUTH_TOKEN>"
#            (that field is in beta; contact Anthropic if you don't have it)

# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0                  # 127.0.0.1 outside a container
# MCP_PORT=8000
# MCP_AUTH_MODE=token
# MCP_AUTH_TOKEN=                   # openssl rand -hex 32
# INVENTREE_TOKEN=inv-...           # required: calls use this service account


# ── C. Hosted over HTTP, per-user OAuth (recommended) ─────────────────────────
# Each user signs into InvenTree through Claude, and their own token is
# forwarded to the InvenTree API — so InvenTree applies that user's role
# permissions rather than a shared account's.
#
# INVENTREE_TOKEN is NOT needed here; no call uses a service account.
#
# Setup, in order:
#  1. Enable OIDC in InvenTree's .env:
#       INVENTREE_FLAGS={"OIDC": [{"condition": "boolean", "value": true}]}
#  2. Create a dedicated InvenTree user for Claude with only the roles the
#     tools should have. Do NOT use a superuser: whoever connects grants Claude
#     exactly their own permissions, and a trimmed scope list below may not
#     restrict that on its own.
#  3. Register an application at /o/applications/register/ with:
#       Client type              Confidential
#       Authorization grant type Authorization code
#       Algorithm                RSA with SHA-2 256   (required for openid)
#       Redirect uris            https://claude.ai/api/mcp/auth_callback
#     Copy the client secret before saving if you tick "Hash client secret".
#  4. Put that client ID and secret into Claude's connector Advanced settings —
#     NOT into this file. This server never sees them in userinfo mode.

# MCP_TRANSPORT=http
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
# MCP_AUTH_MODE=oauth

# This server's canonical public URL. Must match what is typed into Claude
# exactly, including scheme and any path, or OAuth discovery fails.
# MCP_PUBLIC_URL=https://inventree-mcp.example.com

# InvenTree's OAuth issuer. Confirm against
# {INVENTREE_URL}/o/.well-known/openid-configuration -> "issuer".
# OAUTH_ISSUER=https://inventree.example.com/o

# Scopes Claude is asked to request; shown on the consent screen. Required.
# Leaving it unset makes Claude request every scope InvenTree advertises,
# including delete. "openid" is mandatory in userinfo mode.
#
# CHANGING THIS DOES NOT AFFECT AN ALREADY-CONNECTED CLIENT. A token carries the
# scopes it was granted at consent, and refreshing renews that same set — it
# never widens it. After editing this line, disconnect and re-add the connector
# in Claude, or every newly-added scope still returns 403.
#
# The list below covers the read/write tools across all six domains the server
# exposes: part, part_category, stock, stock_location, bom, build,
# purchase_order, sales_order and return_order. Company, supplier-part and
# manufacturer-part writes have no scope of their own — InvenTree governs them
# with the purchase_order role. Omitted deliberately: r:delete:* (see below),
# r:*:admin, r:*:transfer_order, a:staff and a:superuser, none of which any tool
# needs.
# OAUTH_SCOPES="openid g:read r:view:part r:add:part r:change:part r:view:part_category r:add:part_category r:change:part_category r:view:stock r:add:stock r:change:stock r:view:stock_location r:add:stock_location r:change:stock_location r:view:bom r:add:bom r:change:bom r:view:build r:add:build r:change:build r:view:purchase_order r:add:purchase_order r:change:purchase_order r:view:sales_order r:add:sales_order r:change:sales_order r:view:return_order r:add:return_order r:change:return_order"

# The five delete_* tools (delete_part, delete_part_category, delete_stock_item,
# delete_stock_location, delete_bom_item) additionally need the line below
# appended to OAUTH_SCOPES. The cancel_* tools do NOT — they change an order's
# status rather than removing a record, so r:change:* already covers them.
# Verify that omitting r:delete:* actually blocks deletion on your instance —
# scope enforcement was not observed to be reliable, and the connected user's
# role permissions are the control that definitely applies.
# r:delete:part r:delete:part_category r:delete:stock r:delete:stock_location r:delete:bom


# ── C-2. Optional: verify tokens by introspection instead of userinfo ─────────
# Default is userinfo, which is what InvenTree advertises and needs no client
# credentials. Choose introspect only if you must enforce scopes at THIS server
# — it is the only mode that reports the scopes a token carries. InvenTree does
# not advertise an introspection endpoint, so confirm yours works first.

# OAUTH_VERIFY=introspect
# OAUTH_CLIENT_ID=                  # a second application, for this server
# OAUTH_CLIENT_SECRET=
# OAUTH_INTROSPECTION_URL=          # defaults to {OAUTH_ISSUER}/introspect/
# OAUTH_USERINFO_URL=               # defaults to {OAUTH_ISSUER}/userinfo/


# ── Optional: image search ────────────────────────────────────────────────────
# Enables the search_part_images tool. Without these the server still starts and
# every other tool works; only that one returns an explanatory error.
# set_part_image and the image_url arguments work regardless — they take a URL.

# GOOGLE_API_KEY=
# GOOGLE_CSE_ID=
